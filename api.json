          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "currency": {
            "type": "string"
          },
          "dataQuantity": {
            "type": "integer"
          },
          "dataUnit": {
            "type": "string"
          },
          "packageValidity": {
            "type": "integer"
          },
          "packageValidityUnit": {
            "type": "string"
          },
          "packageType": {
            "type": "string",
            "nullable": true
          },
          "unlimited": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          },
          "countryCode": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Card.Esim.Create.Request": {
        "required": [
          "catalogEsimId"
        ],
        "properties": {
          "catalogEsimId": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Card.Esim.List.Request": {
        "required": [
          "page",
          "quantity"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "default": 1
          },
          "quantity": {
            "type": "integer",
            "default": 20
          }
        },
        "type": "object"
      },
      "Card.Esim.Response": {
        "required": [
          "id",
          "userId",
          "catalogEsimId",
          "qrDataInstallation",
          "transactionId",
          "status",
          "iccid",
          "providerStatus",
          "remainingDataQuantity",
          "remainingDataUnit",
          "packageName",
          "packageDescription",
          "price",
          "currency",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "catalogEsimId": {
            "type": "integer"
          },
          "transactionId": {
            "type": "integer"
          },
          "qrDataInstallation": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "iccid": {
            "type": "string",

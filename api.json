{
  "openapi": "3.0.0",
  "info": {
    "title": "Roamly eSim api",
    "version": "0.1.0"
  },
  "paths": {
    "/api/balances/transactions/{transactionId}": {
      "get": {
        "tags": [
          "Balance"
        ],
        "description": "Get current user transaction details",
        "operationId": "getBalanceTransaction",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns transaction details",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "transaction"
                          ],
                          "properties": {
                            "transaction": {
                              "$ref": "#/components/schemas/Balance.Transaction.Response"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/balances/transactions": {
      "get": {
        "tags": [
          "Balance"
        ],
        "description": "Get current user balance transactions list",
        "operationId": "getBalanceTransactions",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns transactions list",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "transactions",
                            "pagination"
                          ],
                          "properties": {
                            "transactions": {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "$ref": "#/components/schemas/Balance.Transaction.Response"
                                  }
                                ]
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/PaginationResponse"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/catalog/countries": {
      "get": {
        "tags": [
          "Card"
        ],
        "description": "Get country dictionary filtered by active eSIM catalog availability",
        "operationId": "getAvailableCatalogCountries",
        "responses": {
          "200": {
            "description": "Returns available catalog countries",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "countries"
                          ],
                          "properties": {
                            "countries": {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "$ref": "#/components/schemas/Card.CountryDictionaryItem.Response"
                                  }
                                ]
                              }
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/catalog/esims": {
      "get": {
        "tags": [
          "Card"
        ],
        "description": "Get eSIM catalog with filters",
        "operationId": "getCatalogEsimList",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2,
              "minLength": 2,
              "nullable": true
            }
          },
          {
            "name": "dataFrom",
            "in": "query",
            "schema": {
              "description": "Minimum data quantity in GB",
              "type": "number",
              "format": "number",
              "nullable": true
            }
          },
          {
            "name": "dataTo",
            "in": "query",
            "schema": {
              "description": "Maximum data quantity in GB",
              "type": "number",
              "format": "number",
              "nullable": true
            }
          },
          {
            "name": "validityFrom",
            "in": "query",
            "schema": {
              "description": "Minimum package validity in days",
              "type": "integer",
              "nullable": true
            }
          },
          {
            "name": "validityTo",
            "in": "query",
            "schema": {
              "description": "Maximum package validity in days",
              "type": "integer",
              "nullable": true
            }
          },
          {
            "name": "sortByDataQuantity",
            "in": "query",
            "schema": {
              "description": "Sort by data quantity normalized to GB",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "nullable": true
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns eSIM catalog list",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "catalog",
                            "pagination"
                          ],
                          "properties": {
                            "catalog": {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "$ref": "#/components/schemas/Card.CatalogEsim.Response"
                                  }
                                ]
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/PaginationResponse"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/esims": {
      "get": {
        "tags": [
          "Card"
        ],
        "description": "Get current user eSIM cards",
        "operationId": "getListEsimCards",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns current user eSIM cards",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "esims",
                            "pagination"
                          ],
                          "properties": {
                            "esims": {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "$ref": "#/components/schemas/Card.Esim.Response"
                                  }
                                ]
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/PaginationResponse"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Card"
        ],
        "description": "Create eSIM card from catalog package",
        "operationId": "createEsimCard",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Card.Esim.Create.Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Creates eSIM card for current user",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "esim"
                          ],
                          "properties": {
                            "esim": {
                              "$ref": "#/components/schemas/Card.Esim.Response"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/esims/{esimCardId}": {
      "get": {
        "tags": [
          "Card"
        ],
        "description": "Get current user eSIM card details",
        "operationId": "getEsimCardDetails",
        "parameters": [
          {
            "name": "esimCardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns eSIM card details",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "esim"
                          ],
                          "properties": {
                            "esim": {
                              "$ref": "#/components/schemas/Card.Esim.Response"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/esims/{esimCardId}/refresh": {
      "post": {
        "tags": [
          "Card"
        ],
        "description": "Refresh eSIM card data from provider",
        "operationId": "refreshEsimCard",
        "parameters": [
          {
            "name": "esimCardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns refreshed eSIM card",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "success",
                        "data"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "data": {
                          "required": [
                            "esim"
                          ],
                          "properties": {
                            "esim": {
                              "$ref": "#/components/schemas/Card.Esim.Response"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me/configure": {
      "post": {
        "tags": [
          "User"
        ],
        "description": "Configure user tokens",
        "operationId": "configureUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/User.Configure.Request"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configure user",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/User.Configure.Response"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "User"
        ],
        "description": "Get user details",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Returns the authenticated user details",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/User.Details.Response"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Balance.Transaction.List.Request": {
        "required": [
          "page",
          "quantity"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "default": 1
          },
          "quantity": {
            "type": "integer",
            "default": 20
          }
        },
        "type": "object"
      },
      "Balance.Transaction.Response": {
        "required": [
          "id",
          "userId",
          "type",
          "status",
          "amount",
          "currency",
          "settlementAmount",
          "settlementCurrency",
          "description",
          "createdAt",
          "updatedAt",
          "completedAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount": {
            "type": "number",

            "nullable": true
          },
          "dataFrom": {
            "type": "number",
            "format": "number",
            "nullable": true
          },
          "dataTo": {
            "type": "number",
            "format": "number",
            "nullable": true
          },
          "validityFrom": {
            "type": "integer",
            "nullable": true
          },
          "validityTo": {
            "type": "integer",
            "nullable": true
          },
          "sortByDataQuantity": {
            "type": "string",
            "enum": [

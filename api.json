    "securitySchemes": {
      "tma": {
        "type": "apiKey",
        "description": "Use format `tma <token>`, e.g., `tma initUserDataFromTelegram`. In dev environment use format for autologin Bearer `<login>`",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [

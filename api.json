          "totalQuantity",
          "currentPage",
          "pages"
        ],
        "properties": {
          "quantity": {
            "type": "integer"
          },
          "totalQuantity": {
            "type": "integer"
          },
          "currentPage": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        },
        "type": "object"
      },
